# MOS extraction 5V CMOS
#
extract_devices(mos4("PMOS" ), 
                            { "SD" => (MP - GC),        # S/D region
                              "G"  => (MP & GC),        # Channel region
                              "W"  => (MP & GC & WN),   # Backgate region
                              "tS" => (SDP),            # Terminal: Source
                              "tD" => (SDP),            # Terminal: Drain
                              "tG" => (GC),             # Terminal: Gate
                              "tB" => (WN) })           # Terminal: Backgate
#
tolerance("PMOS", "W", :relative => 0.01)           # 1% tolerance 
tolerance("PMOS", "L", :relative => 0.0)            # 0% tolerance 
#
extract_devices(mos4("NMOS" ), 
                            { "SD" => (MN - GC),        # S/D region
                              "G"  => (MN & GC),        # Channel region
                              "W"  => (MN & GC & BULK), # Backgate region
                              "tS" => (SDN),            # Terminal: Source
                              "tD" => (SDN),            # Terminal: Drain
                              "tG" => (GC),             # Terminal: Gate
                              "tB" => (BULK) })         # Terminal: Backgate
#
tolerance("NMOS", "W", :relative => 0.01)           # 1% tolerance 
tolerance("NMOS", "L", :relative => 0.0)            # 0% tolerance 
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# MOS extraction 5V CMOS for ESD only NMOS is special
#
extract_devices(mos4("PMOS" ), 
                            { "SD" => (MPE - GC),       # S/D region
                              "G"  => (MPE & GC),       # Channel region
                              "W"  => (MPE & GC & WN),  # Backgate region
                              "tS" => (SDPE),           # Terminal: Source
                              "tD" => (SDPE),           # Terminal: Drain
                              "tG" => (GC),             # Terminal: Gate
                              "tB" => (WN) })           # Terminal: Backgate

extract_devices(mos4("NMOSE" ), 
                            { "SD" => (MNE - GC),        # S/D region
                              "G"  => (MNE & GC),        # Channel region
                              "W"  => (MNE & GC & BULK), # Backgate region
                              "tS" => (SDNE),            # Terminal: Source
                              "tD" => (SDNE),            # Terminal: Drain
                              "tG" => (GC),              # Terminal: Gate
                              "tB" => (BULK) })          # Terminal: Backgate
#
tolerance("NMOSE", "W", :relative => 0.01)            # 1% tolerance 
tolerance("NMOSE", "L", :relative => 0.0)             # 0% tolerance 
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# DIODE extraction
#
extract_devices(diode("DP"), 
                            { "P"  => (DP),           # P region
                              "N"  => (DP & WN),      # N region
                              "tA" => (DP),           # Terminal: Anode
                              "tC" => (WN) })         # Terminal: Cathode
#                              
tolerance("DP", "A", :relative => 0.05)               # 5% tolerance 
tolerance("DP", "P", :relative => 0.05)               # 5% tolerance 
#
extract_devices(diode("DN"),                          # Floating Protection
                            { "P"  => (DN & BULK),    # P region
                              "N"  => (DN),           # N region
                              "tA" => (BULK),         # Terminal: Anode
                              "tC" => (DN) })         # Terminal: Cathode
#
tolerance("DN", "A", :relative => 0.05)               # 5% tolerance 
tolerance("DN", "P", :relative => 0.05)               # 5% tolerance 
#
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Resistor extraction
#
extract_devices(resistor("F_RS", 1, LWResistor),
                    { "R"  => (RS),              # Resistance Layer`
                      "C"  => (RSC),             # Contact Layer
                      "tA" => (RSC),             # Terminal: A
                      "tB" => (RSC) })           # Terminal: B
#
tolerance("F_RS", "W", :relative => 0.01)        # 1% tolerance 
tolerance("F_RS", "L", :relative => 0.01)        # 1% tolerance
ignore_parameter("F_RS", "R")                    # ignore "R" for comparison
#
extract_devices(resistor_with_bulk("F_RR", 1, LWResistorWithBulk),
                    { "R"  => (RR),              # Resistance Layer`
                      "C"  => (ARC),             # Contact Layer
                      "W"  => (AR),              # NWELL plate
                      "tA" => (ARC),             # Terminal: A
                      "tB" => (ARC),             # Terminal: B
                      "tW" => (WR) })            # Terminal: NWELL
#
tolerance("F_RR", "W", :relative => 0.01)        # 1% tolerance
tolerance("F_RR", "L", :relative => 0.01)        # 1% tolerance
ignore_parameter("F_RR", "R")                    # ignore "R" for comparison
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
equivalent_pins("F_RS", "A", "B")
equivalent_pins("F_RR", "A", "B")

extract_devices(capacitor_with_bulk("F_CSIO", 0.6e-15, LWCapacitorWithBulk), 
                    { "P1" => (GC),             # Top plate
                      "P2" => (AC),             # Bottom plate
                      "W"  => (WC),             # Bulk plate
                      "tA" => (GC),             # Terminal: A
                      "tB" => (WC),             # Terminal: B
                      "tW" => (BULK) })         # Terminal: BULK

# tolerance("F_CSIO", "C", :relative => 0.01)     # 1% tolerance 
tolerance("F_CSIO", "A", :relative => 0.01)     # 1% tolerance 
tolerance("F_CSIO", "P", :relative => 0.01)     # 1% tolerance 
ignore_parameter("F_CSIO", "C")                 # ignore "C" for comparison
ignore_parameter("F_CSIO", "W")                 # ignore "W" for comparison
ignore_parameter("F_CSIO", "L")                 # ignore "L" for comparison
