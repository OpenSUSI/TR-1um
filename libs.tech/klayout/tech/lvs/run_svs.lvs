#===========================================================================================================
# ------------------------------------------ TR-1um SVS RULE DECK ------------------------------------------
#===========================================================================================================

require 'time'
require 'etc'

exec_start_time = Time.now


#================================================
#----------------- FILE SETUP -------------------
#================================================

puts("Starting running TR-1um Klayout SVS runset on #{$input}")
source($input)
puts("Ruby Version for klayout: #{RUBY_VERSION}")

puts('Loading database to memory is complete.')

require 'fileutils'

# Use the supplied report path, otherwise write beside the first netlist.
report_path = $report.to_s.strip
if report_path.empty?
  raise "Missing target_netlist" if $target_netlist.to_s.strip.empty?

  report_path = File.join(
    File.dirname(File.expand_path($target_netlist)),
    "comparison.lvsdb"
  )
end

report_path = File.expand_path(report_path)
FileUtils.mkdir_p(File.dirname(report_path))

puts("SVS report: #{report_path}")
report_lvs(report_path)

#================================================
#------------------ SWITCHES --------------------
#================================================

puts('Evaluate switches.')

def bool_check?(obj)
  obj.to_s.downcase == 'true'
end

# TOP_LVL_PINS
TOP_LVL_PINS = bool_check?($top_lvl_pins)

puts("Selected TOP_LVL_PINS option: #{TOP_LVL_PINS}")

# COMBINE
COMBINE_DEVICES = bool_check?($combine_devices)

puts("Selected COMBINE DEVICES option: #{COMBINE_DEVICES}")

# PURGE
PURGE = bool_check?($purge)

puts("Selected PURGE option: #{PURGE}")

# PURGE_NETS
PURGE_NETS = bool_check?($purge_nets)

puts("Selected PURGE_NETS option: #{PURGE_NETS}")

# SIMPLIFY
SIMPLIFY = !bool_check?($no_simplify)

puts("Selected SIMPLIFY option: #{SIMPLIFY}")

# SIMPLIFY
SERIES_RES = !bool_check?($no_series_res)

puts("Selected SERIES_RES option: #{SERIES_RES}")

# SIMPLIFY
PARALLEL_RES = !bool_check?($no_parallel_res)

puts("Selected PARALLEL_RES option: #{PARALLEL_RES}")

#=== PRINT DETAILS ===
puts("Verbose mode: #{$verbose}")
if $verbose == 'true'
  verbose(true)
else
  verbose(false)
end

# === Tech Switches ===

#================================================
# --------------- CUSTOM CLASSES ----------------
#================================================

# %include 03_Combiner.lvs
## %include 01_Extract.lvs
# %include 02_Extract.lvs
# %include 04_Custom.lvs
## %include 05_Compare.lvs

# Instantiate a reader using the new delegate
reader = RBA::NetlistSpiceReader.new(MyReader.new)

netlist.read($target_netlist, reader)
schematic($schematic, reader)

puts("SVS extracted netlist at: #{$target_netlist}")

hook_path = $pre_align_hook.to_s.strip

unless hook_path.empty?
  hook_path = File.expand_path(hook_path)
  raise "Pre-align hook not found: #{hook_path}" unless File.file?(hook_path)

  puts("Running pre-align hook: #{hook_path}")
  instance_eval(File.read(hook_path), hook_path, 1)
end

# === Aligns the extracted netlist vs. the schematic ===
puts('Starting TR-1um SVS Alignment')
align

#=== NETLIST OPTIONS ===
puts('Starting TR-1um SVS Simplification')
# SIMPLIFY
#netlist.simplify if SIMPLIFY
#schematic.simplify if SIMPLIFY

# TOP_LVL_PINS
#netlist.make_top_level_pins if TOP_LVL_PINS
#schematic.make_top_level_pins if TOP_LVL_PINS

# COMBINE_DEVICES
#netlist.combine_devices if COMBINE_DEVICES
#schematic.combine_devices if COMBINE_DEVICES

# PURGE
#netlist.purge if PURGE
#schematic.purge if PURGE

# PURGE_NETS
#netlist.purge_nets if PURGE_NETS
#schematic.purge_nets if PURGE_NETS

#=== IGNORE EXTREME VALUES ===
#max_res(1e9)
#min_caps(1e-18)


# Compare the netlists
max_branch_complexity(500000)
svs_result = compare
port_check_result = flag_missing_ports

# Check result
if svs_result && port_check_result
    print("Schematic-vs-Schematic comparison PASSED.")
else
    print("Mismatch found. Generating report...")
end

