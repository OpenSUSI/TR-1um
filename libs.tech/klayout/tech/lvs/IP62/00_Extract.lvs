# ----- ------ ----- ----- ------ ----- ----- ------ -----
# RR Resistance
#
AARC = AARR & NSD - PSD          # RR Contact
AARB = AARR & NSD & PSD          # RR Body
#
ARW = (AARR - (CONT & AARR).sized(2.0)).sized(2.0)          # AR WIDE SIDE to measure RR Length
RR_raw  = ARW & AARR                                        # ACTUAL RR
RRT = AARR - RR_raw                                         # RR terminals
RRT_multi_CO = RRT.interacting(CONT, 2 .. nil)
RR_rect = RR_raw.rectangles.not_interacting(RRT_multi_CO)   # RR marker
RRB = RR_rect.overlapping(PSD) & NSD                         # RR body
if ! RR_rect.is_empty? && RRB.is_empty?
  puts("### ERROR: Missing PSD or NSD layers on RR resistors")
end
ARC = AARR - RRB                                            # RR Contact
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Saliside Gate Resistance
#
SGR = SG.interacting(DLRS)       # SG for RS
SGC = SGR - RS                   # RS Contact
SGB = SGR & RS                   # RS Body
#
# SGG = SG.not_interacting(RS)     # SG for except RS
#
CRS = (CONT & SGR).sized(0.5).sized(-0.5)                   # RS CO merged with 1.0um spacing
RSW = (SGR - (CONT & SGR).sized(2.0)).sized(2.0)            # RS WIDE SIDE to measure RS Length
RS_raw  = RSW & SGR                                         # ACTUAL RS
RST = SGR - RS_raw                                          # RS terminals
RST_multi_CO = RST.interacting(CRS, 2 .. nil)
RS_rect = RS_raw.rectangles.not_interacting(RST_multi_CO)   # RS marker
RSB = RS_rect & PSD - NSD                                   # RS body
if ! RS_rect.is_empty? && RSB.is_empty?
  puts("### ERROR: Missing PSD layer on RS resistors")
end
#
RSC = SGR - RSB                                             # RS Contact
SGG = SG - RSB                                              # SG except RS body
#
# rdb = new_report("Only for debug", "debug.lyrdb")
# RSB.output('[Debug]RSB', rdb)
# RSC.output('[Debug]RSC', rdb)
# SGG.output('[Debug]SGG', rdb)
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Electical connection layers
#
SDMP = (AAMP - SGG)      # MP S/D
SDMN = (AAMN - SGG)      # MN S/D
SDPE = (AAPE - SGG)      # MPE S/D
SDNE = (AANE - SGG)      # MNE S/D
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Global node
#
connect_global(BULK, "VSS")
#
# ----- ------ ----- ----- ------ ----- ----- ------ -----
# Connections
#
# ---
# Well
connect(NWMP, AAGP)      # NWELL
connect(BULK, AAGN)      # BULK
# ---
# Active
connect(NWCS, AACC)      # CIS
connect(NWCS, AAGC)      # CIS
connect(NWRR, AAGR)      # BG-RR
# ---
# mos
connect(SDMP, CONT)      # MP S/D
connect(SDMN, CONT)      # MN S/D
connect(SDPE, CONT)      # MPE S/D
connect(SDNE, CONT)      # MNE S/D
connect(AAGP, CONT)      # BG-PMOS
connect(AAGN, CONT)      # BG-NMOS
# ---
# diode
connect(AADP, CONT)      # DP
connect(AADN, CONT)      # DN
# ---
# capacitance
connect(AAGC, CONT)      # BG-CIS
# ---
# resistance
connect(AARC, CONT)      # RR Terminal
connect(ARC,  CONT)      # RR Terminal
connect(AAGR, CONT)      # BG-RR
# connect(SGC,  CONT)      # RS-CONT
connect(RSC,  CONT)      # RS-CONT
# ---
# BEOL
connect(SGG,  CONT)      # SGG-CONT
connect(CONT, M1)        # CONT-M1
connect(M1,   TC)        # M1-TC
connect(TC,   M2)        # TC-M2
connect(M1,   M1_LBL)    # Attaches labels
connect(M2,   M2_LBL)    # Attaches labels
