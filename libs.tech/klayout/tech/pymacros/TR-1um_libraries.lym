import sys
import os
import pya

tech_name = "TR-1um"

# install the path to the PCell lib unless it is there already
here = os.path.dirname(__file__)
tech_dir = os.path.dirname(here)
pcell_path = os.path.realpath(os.path.join(tech_dir, "python"))
if not pcell_path in sys.path:
    sys.path.insert(0, pcell_path)

from cells import tr_1um

# Register the library
tr_1um(tech_name)

print("Loaded TR-1um PCells.")

# directory containing this script
libraries = [{ "name":         "TR-1um_stdcell", 
               "description":  "TR-1um standard cells",
               "gds":          "TR-1um_STDCELL.gds"
             },
             { "name":         "TR-1um_frame",     
               "description":  "TR-1um pad frame",
               "gds":          "TR-1um_frame_25x25.gds"
             },
             { "name":         "TR-1um_ESD",     
               "description":  "TR-1um ESD devices",
               "gds":          "TR-1um_ESD.gds"
             },
             { "name":         "TR-1um_Characters1",     
               "description":  "TR-1um Metal1 0-1,A-Z",
               "gds":          "TR-1um_Characters1.gds"
             },
             { "name":         "TR-1um_Characters2",     
               "description":  "TR-1um Metal2 0-1,A-Z",
               "gds":          "TR-1um_Characters2.gds"
             },
            ]

library_path = os.path.join(os.path.dirname(tech_dir), "libraries")

for library in libraries:
    lib = pya.Library()
    lib.layout().read(os.path.join(library_path, library["gds"]))
    lib.description = library["description"]
    lib.add_technology(tech_name)
    lib.register(library["name"])

</text>
</klayout-macro>
