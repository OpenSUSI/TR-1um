# Basic check for layer polygons
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Original version was made by jun1okamura from TokaiRika's document 
# LICENSE: Apache License Version 2.0, January 2004,
#          http://www.apache.org/licenses/
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
#  Key Layer definition
#
WR  = WN.covering(AR)                                       # Nwell for RR
WC  = WN.covering(AC)                                       # Nwell for CSIO
WM  = WN.covering(AP)                                       # Nwell for PMOS
#
AA  = (AN + AP + AC + AR)                                   # ALL ACTIVE
GA  = (GC + GR)                                             # ALL POLY
#
MP  = (AP.interacting(GC) & WN - ESD)                       # PMOS diffusion
MN  = (AN.interacting(GC) & WP - ESD)                       # NMOS diffusion
AM  = (MP + MN)                                             # ALL MOS
AM_h = AM.edges.interacting(GC)                             # MOS diffusion edges crossing poly
#
MPE = (AP.interacting(GC) & WN & ESD)                       # PMOS (ESD)
MNE = (AN.interacting(GC) & WP & ESD)                       # NMOS (ESD)
AME = (MPE + MNE)                                           # ALL MOS (ESD)
AME_h = AME.edges.interacting(GC)                           # MOS (ESD) diffusion edges crossing poly
#
GP  = (AN & WN)                                             # BG-contact (PMOS) (poly interaction not relevant)
GN  = (AP & WP)                                             # BG-contact (NMOS) (poly interaction not relevant)
BG  = (GP + GN)                                             # BG-contact
BGM = (BG - WC)                                             # BG-contact except for CSIO
#
DP  = (AP.not_interacting(GC) & WN)                         # DIODE(P)
DN  = (AN.not_interacting(GC) & WP)                         # DIODE(N)
AD  = (DP + DN)                                             # ALL DIODE 
#
CL  = CO.drc( area >= 1.5 )                                 # LARGE CONTACT
COM = CO & (MP + MN)                                        # S/D CONTACT on MOSFET
COM_s = COM.drc((space(projection) <= 1.0).polygons) # Requires width and space from DRM
# end of row diffusion contacts. enclosure is half max enclosure allowed without adding another CO
COM_e = COM.edges.enclosed(AM_h, 0.8+1.0+1.dbu, projection).polygons
COE = CO & (MPE + MNE)                                      # S/D CONTACT on ESD MOSFET
COE_s = COE.drc((space(projection) <= 1.6).polygons) # Requires width and space from DRM
# end of row diffusion contacts. enclosure is half max enclosure allowed without adding another CO
# DRM calculates to 4.8um, but actual layout is 5.1um, so add 0.3um fudge factor
COE_e = COE.edges.enclosed(AME_h, 2.5+(1.6+3.0)/2+0.3+1.dbu, projection).polygons
CS  = CO - (AR + WC + AD + MPE + MNE)                       # Small CO
#
M1W = M1.sized(-5.0).merged.sized(5.0).merged               # WIDE M1
M1C = (M1 & WC & AN).interacting(CO)                        # M1 for GUARD-RING (CSIO)
ANC = (AN.interacting(M1C) - M1C).sized(-1.8+1.dbu).sized(1.8-1.dbu) # AN for GUARD-RING (CSIO) without M1C
M1P = M1.interacting(PO).sized(-35.0).sized(35.0)           # M1 for PAD
# M1W.output("M1W")                                         # DEBUG
#
V1P = V1.interacting(PO)                                    # M1 for PAD
#
M2P = M2.interacting(PO).sized(-35.0).sized(35.0)           # M2 for PAD
#
PP = PO.with_bbox_max(70.0 ..)                              # Bonding pads have at least one dimension as 70um
#
CRS = (CO & GR).sized(0.5).sized(-0.5)                      # RS CO merged with 1.0um spacing
RSW = (GR - (CO & GR).sized(2.0)).sized(2.0)                # RS WIDE SIDE to measure RS Length
ARW = (AR - (CO & AR).sized(2.0)).sized(2.0)                # AR WIDE SIDE to measure RR Length

RS_raw  = RSW & GR                                          # ACTUAL RS
RR_raw  = ARW & AR                                          # ACTUAL RR

RST = GR - RS_raw                                           # RS terminals
RRT = AR - RR_raw                                           # RR terminals

RST_multi_CO = RST.interacting(CRS, 2 .. nil)
(CRS & RST_multi_CO).output("[EXT] merged CO error. Only one merged CO per RS terminal allowed. Use minimum CO space.")
RS_raw.non_rectangles.output("[EXT] Invalid RS. Check CO spacing and enclosure.")
RS = RS_raw.rectangles.not_interacting(RST_multi_CO)        # Valid RS

RRT_multi_CO = RRT.interacting(CO, 2 .. nil)
(CO & RRT_multi_CO).output("[EXT] Only one CO per RR terminal allowed.")
RR_raw.non_rectangles.output("[EXT] Invalid RR. Check CO enclosure.")
RR = RR_raw.rectangles.not_interacting(RRT_multi_CO)        # Valid RR

# AR enclosure of CO must be < 2.0 on 3 sides or else the device won't be extracted properly
# This is not a DRM rule, but a consequence of the extraction method
(CO & AR).drc( 2.0 < enclosed(AR.interacting(RR)) < 13.0 ).output('[EXT] can not extract RR if AR enclosure of CO > 2.0')
# GR enclosure of CO must be < 2.0 on 3 sides or else the device won't be extracted properly
# This is not a DRM rule, but a consequence of the extraction method
(CRS - RST_multi_CO).drc( 2.0 < enclosed(GR.interacting(RS)) < 13.0 ).output('[EXT] can not extract RS if GR enclosure of merged CO > 2.0')
#


RR28 = RR.interacting(RR.edges.inside_part(AR).with_length(2.8), 2 )   # 2.8um width RR
RR40 = RR.interacting(RR.edges.inside_part(AR).with_length(4.0), 2 )   # 4.0um width RR
RR60 = RR.interacting(RR.edges.inside_part(AR).with_length(6.0), 2 )   # 6.0um width RR
RR120 = RR.interacting(RR.edges.inside_part(AR).with_length(12.0), 2 ) # 12.0um width RR
RR200 = RR.interacting(RR.edges.inside_part(AR).with_length(20.0), 2 ) # 20.0um width RR

RRN = RR28                                 # narrow RR: 2.8um
RRW = RR40 + RR60 + RR120 + RR200          # wide RR: 4um, 6um, 12um, 20um
RROK = RRN + RRW

ARNS = AR.edges.interacting(RRN.edges)
ARWS = AR.edges.interacting(RRW.edges)
ART = AR.edges.not_interacting(RR_raw.edges).with_angle(ortho)

RS40 = RS.interacting(RS.edges.inside_part(GR).with_length(4.0), 2 )    # 4.0um width RS
RS60 = RS.interacting(RS.edges.inside_part(GR).with_length(6.0), 2 )    # 6.0um width RS
RS120 = RS.interacting(RS.edges.inside_part(GR).with_length(12.0), 2 )  # 12.0um width RS
RS200 = RS.interacting(RS.edges.inside_part(GR).with_length(20.0), 2 )  # 20.0um width RS
RSOK = RS40 + RS60 + RS120 + RS200                                  # Valid RS resistor widths

GRS = GR.edges.interacting(RS.edges)
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# RR Resistance
#
ARC = AR - RR                   # RR Contact
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Saliside Gate Resistance
#
RSC = GR - RS                   # RS Contact
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Electical connection layers
#
SDP  = (MP  - GC)               # MP S/D
SDN  = (MN  - GC)               # MN S/D
SDPE = (MPE - GC)               # MPE S/D
SDNE = (MNE - GC)               # MNE S/D
SDC  = (AM - GC).interacting(CO)  # Normal mos source/drain with CO
SDEC = (AME - GC).interacting(CO) # ESD mos source/drain with CO
#
GC_ext1 = GA.edges.inside_part(AM).extended_out(1.0).edges.inside_part(SDC)
# ESD diffusion long side
APT = MPE.edges.not_interacting(GC).with_angle(ortho)
ANT = MNE.edges.not_interacting(GC).with_angle(ortho)
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Global node
#
connect_global(BULK, "VSS")
connect_global(GN,   "VSS")
#
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Connections
#
# ---
# Well 
connect(WN  , GP)       # NWELL
#connect(WP,   GN)       # BULK
#connect(BULK, GN)       # BULK
# ---
# Active
connect(WC,   AC)       # CIS
connect(WC,   GP)       # BG-CIS
connect(WR,   RR)       # BG-RR
connect(WR,   GP)       # BG-RR
# ---
# mos
connect(SDP,  CO)       # MP S/D
connect(SDN,  CO)       # MN S/D
connect(SDPE, CO)       # MPE S/D
connect(SDNE, CO)       # MNE S/D
connect(GP,   CO)       # BG-PMOS
connect(GN,   CO)       # BG-NMOS
# ---
# diode
connect(DP,   CO)       # DP
connect(DN,   CO)       # DN
# ---
# resistance
connect(ARC,  CO)       # RR Terminal
connect(RSC,  CO)       # RS-CONT
# ---
# BEOL
connect(GC,   CO)       # GC-CO
connect(CO,   M1)       # CO-M1
connect(M1,   V1)       # M1-V1
connect(V1,   M2)       # V1-M2
connect(M1,   M1_LBL)   # Attaches labels
connect(M2,   M2_LBL)   # Attaches labels
#
# Reliability rules.
#
# Check contact density on AC. Flag locations where another CO could be added
AC_check_region = AC.sized(-3.5)  # AC - CO enclosure 2.9um + 1/2 CO width 1.2um = 3.5um
AC_CO_coverage = (CO & AC).sized(1.8-1.dbu)  # CO space 1.2um + 1/2 CO width 1.2um
(AC_check_region - AC_CO_coverage).sized(0.6).output("Warning: missing CSIO CO")

# Check contact density on CSIO guard ring. Flag locations where another CO could be added
M1C_check_region = M1C.sized(-1.8+1.dbu)  # M1C - CO enclosure 1.2um + 1/2 CO width 1.2um = 1.8um
M1C_CO_coverage = (CO & M1C).sized(1.8-1.dbu)  # CO space 1.2um + 1/2 CO width 1.2um
(M1C_check_region - M1C_CO_coverage).sized(0.6).output("Warning: missing CSIO guardring CO")

# Check contact density on normal guard ring. Flag locations where another CO could be added
BG_check_region = (M1 & BGM).interacting(CO).sized(-1.3+1.dbu)  # BGM - CO enclosure 0.8um + 1/2 CO width 1.0um = 1.3um
BG_CO_coverage = CO.sized(4.5, size_inside(M1 & BGM), steps(10))  # CO space 1.0um x 2.5 + CO width 1.0um x 2 (missing 4 contacts)
(BG_check_region - BG_CO_coverage).sized(0.5).output("Warning: missing guardring CO")



