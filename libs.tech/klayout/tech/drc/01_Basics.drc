# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
#  PTECT
#
(WN & PTECT).output("ERR00: WN on Prohibted area")
(AP & PTECT).output("ERR00: AP on Prohibted area")
(AN & PTECT).output("ERR00: AN on Prohibted area")
(AR & PTECT).output("ERR00: AR on Prohibted area")
(AC & PTECT).output("ERR00: AC on Prohibted area")
(GC & PTECT).output("ERR00: GC on Prohibted area")
(GR & PTECT).output("ERR00: GR on Prohibted area")
(CO & PTECT).output("ERR00: CO on Prohibted area")
(M1 & PTECT).output("ERR00: M1 on Prohibted area")
(V1 & PTECT).output("ERR00: V1 on Prohibted area")
(M2 & PTECT).output("ERR00: M2 on Prohibted area")
(PO & PTECT).output("ERR00: PO on Prohibted area")
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
#  Check off Grid
#
(WN).ongrid( 0.050 ).output( "ERR01: WN OFFGRID 0.050" )
(AP).ongrid( 0.050 ).output( "ERR01: AP OFFGRID 0.050" )
(AN).ongrid( 0.050 ).output( "ERR01: AN OFFGRID 0.050" )
(AR).ongrid( 0.050 ).output( "ERR01: AR OFFGRID 0.050" )
(AC).ongrid( 0.050 ).output( "ERR01: AC OFFGRID 0.050" )
(GC).ongrid( 0.050 ).output( "ERR01: GC OFFGRID 0.050" )
(GR).ongrid( 0.050 ).output( "ERR01: GR OFFGRID 0.050" )
(CO).ongrid( 0.050 ).output( "ERR01: CO OFFGRID 0.050" )
(M1).ongrid( 0.050 ).output( "ERR01: M1 OFFGRID 0.050" )
(V1).ongrid( 0.050 ).output( "ERR01: V1 OFFGRID 0.050" )
(M2).ongrid( 0.050 ).output( "ERR01: M2 OFFGRID 0.050" )
(PO).ongrid( 0.050 ).output( "ERR01: PO OFFGRID 0.050" )
# --------- --------- --------- --------- --------- --------- ---------
#  Twisted Polygon
#
WN.dup.raw.odd_polygons.output("ERR02: NW twisted polygon")
AP.dup.raw.odd_polygons.output("ERR02: AP twisted polygon")
AN.dup.raw.odd_polygons.output("ERR02: AN twisted polygon")
AR.dup.raw.odd_polygons.output("ERR02: AR twisted polygon")
AC.dup.raw.odd_polygons.output("ERR02: AC twisted polygon")
GC.dup.raw.odd_polygons.output("ERR02: GC twisted polygon")
GR.dup.raw.odd_polygons.output("ERR02: GR twisted polygon")
CO.dup.raw.odd_polygons.output("ERR02: CO twisted polygon")
M1.dup.raw.odd_polygons.output("ERR02: M1 twisted polygon")
V1.dup.raw.odd_polygons.output("ERR02: V1 twisted polygon")
M2.dup.raw.odd_polygons.output("ERR02: M2 twisted polygon")
PO.dup.raw.odd_polygons.output("ERR02: PO twisted polygon")
# --------- --------- --------- --------- --------- --------- ---------
#  Check Non-diagonal shape
#
(WN.edges).without_angle(diagonal).output( "ERR03: WN edge not 90 or 45 degrees" )
(AP.edges).without_angle(diagonal).output( "ERR03: AP edge not 90 or 45 degrees" )
(AN.edges).without_angle(diagonal).output( "ERR03: AN edge not 90 or 45 degrees" )
(AR.edges).without_angle(diagonal).output( "ERR03: AR edge not 90 or 45 degrees" )
(AC.edges).without_angle(diagonal).output( "ERR03: AC edge not 90 or 45 degrees" )
(GC.edges).without_angle(diagonal).output( "ERR03: GC edge not 90 or 45 degrees" )
(GR.edges).without_angle(diagonal).output( "ERR03: GR edge not 90 or 45 degrees" )
(CO.edges).without_angle(diagonal).output( "ERR03: CO edge not 90 or 45 degrees" )
(M1.edges).without_angle(diagonal).output( "ERR03: M1 edge not 90 or 45 degrees" )
(V1.edges).without_angle(diagonal).output( "ERR03: V1 edge not 90 or 45 degrees" )
(M2.edges).without_angle(diagonal).output( "ERR03: M2 edge not 90 or 45 degrees" )
(PO.edges).without_angle(diagonal).output( "ERR03: PO edge not 90 or 45 degrees" )
