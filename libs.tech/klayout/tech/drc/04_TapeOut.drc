# Basic check for layer polygons
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Original version was made by jun1okamura from TokaiRika's document 
# LICENSE: Apache License Version 2.0, January 2004,
#          http://www.apache.org/licenses/
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Add rules for matching to the TokaiRika Tape-out policy
#
## dataAuditErrors
# ER0045:M1 SP ER 1.4
# ER0047:M2 SP ER 2.0
## ER1001:PMOS GATE PROTECT WARNING
## ER1002:NMOS GATE PROTECT WARNING
# ER1402:M1(W10OVER&MIX) SP ER 2.0
# ER1811:PAD M1-TC ENC ER 15.0
# ER1812:PAD M2-TC ENC ER 15.0
# ER1903:M1 MAXWIDTH 45.0
## ER2001:TC-TC23 SP ER 1.4
# ERMP08:CONT(MP) SP MUST 1.0
# ERMP11:SG(MP)-CONT SP MUST 1.0
# ERMN09:CONT(MN) SP MUST 1.0
# ERMN12:SG(MN)-CONT(MN) SP MUST 1.0
# ERCSIO06:M1(CSIO CL) SP MUST 10.0
# ERCSIO13:SG-L(CSIO) ENC MUST 1.4
# ERCSIO16:CSIO SG-NSD-CL UNMATCH ER

###polygon_height
def polygon_height(polygon)
  bbox = polygon.bbox
  [bbox.height, bbox.width].max
end

###polygon_width
def polygon_width(polygon)
  bbox = polygon.bbox
  [bbox.height, bbox.width].min
end

# Input layers
diff    = AA
pol     = GA
cnt     = CO
ml1     = input( 13, 0 ).merged
via1    = input( 19, 0 ).merged
ml2     = input( 20, 0 ).merged
pro     = PO
chipring = pro.holes - diff.holes

diff_pol = diff.overlapping(pol)
mp = MP
mn = MN
pgate = pol & mp
ngate = pol & mn
cnt_pol = cnt.outside(pol)
cnt_mp = cnt_pol.inside(mp)
cnt_mn = cnt_pol.inside(mn)
gate_mp = pol & mp
gate_mn = pol & mn

dlcsio  = WC.sized(1.5.um)
cl = AC.sized(1.4.um, square_limit).merged.snap(0.05.um, 0.05.um)

ARs = AR.edges.with_angle(diagonal_only).extents + AR
MPEs = MPE.edges.with_angle(diagonal_only).extents + MPE
MNEs = MNE.edges.with_angle(diagonal_only).extents + MNE
base_implant = (AC + AN + AP + GR + MNEs + MPEs).sized(1.4) + ARs.sized(2.0)
NSD_base = AP + AC + ARs.sized(0.6)
NSD_minimum = NSD_base.sized(1.4)
NSD_spacing = NSD_minimum.sized(2.6+1.4)
NSD_maximum = NSD_minimum.hulls.extents.sized(1.3).extents.sized(-1.3) - base_implant + NSD_minimum
# Undersize by just less than half width to remove minimum width errors
# Final sizing needs to be minimum enclosure to get diagonal spacing correct
NSD_W_OK = (NSD_maximum.sized(-2.1+1.dbu).sized(0.7-1.dbu) + NSD_minimum.sized(-1.4))
# subtract spacing error implant that doesn't do anything
NSD_WS_OK = NSD_W_OK - (NSD_W_OK & NSD_spacing).not_interacting(NSD_minimum)
nsd = (NSD_WS_OK.sized(1.4, octagon_limit) - dlcsio + cl).merged.snap(0.05, 0.05)

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ER0045:M1 SP ER 1.4
# ER0047:M2 SP ER 2.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ml1.space(1.4.um).polygons.merged.output("ER0045:M1 SP ER 1.4")
ml2.space(2.0.um).polygons.merged.output("ER0047:M2 SP ER 2.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ER1402:M1(W10OVER & MIX) SP ER 2.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ml1over10 = ml1.sized(-5.0.um).sized(5.0.um)
# ml1over10.output("[Debug]ml1over10")
ml1.separation(ml1over10, 2.0.um, transparent, without_touching_edges, without_touching_corners).output("ER1402:M1(W10OVER & MIX) SP ER 2.0")
# ml1over10.space(2.0.um).output("ER1402:M1(W10OVER & MIX) SP ER 2.0")  # Not checked by Assura

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ER1811:PAD M1-TC ENC ER 15.0
# ER1812:PAD M2-TC ENC ER 15.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#pad定義
pro_via1 = pro.overlapping(via1)
ml1_ml2 = ml1 & ml2
pro_via1_ml1_ml2 = pro_via1 & ml1_ml2
pad_metal = ml1_ml2.overlapping(pro_via1_ml1_ml2)
pad_10 = pro_via1.sized(10.um) - pad_metal

if pad_10.is_empty?
  pad = pro_via1_ml1_ml2.sized(10.um)
else
  pad = pro_via1_ml1_ml2.sized(5.um)
end

ml1_pad = ml1.overlapping(pad)
via1_pad = via1 & pad
ml2_pad = ml2.overlapping(pad)

er1811 = ml1_pad.enclosing(via1_pad, 15.um)
er1811.output("ER1811:PAD M1-TC ENC ER 15.0")
er1812 = ml2_pad.enclosing(via1_pad, 15.um)
er1812.output("ER1812:PAD M2-TC ENC ER 15.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ER1903:M1 MAXWIDTH 45.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
#sidemetal
sidemetal1 = ml1.overlapping(chipring)
sidemetal2 = ml2.overlapping(chipring)
sidemetal = sidemetal1 | sidemetal2

er1903_1 = ml1 - sidemetal - dlcsio # Assura rules flag CSIO metal
er1903_2 = er1903_1 - pro
er1903_3 = er1903_2.sized(-22.5.um)
er1903 = er1903_3.sized(22.5.um)
er1903.output("ER1903:M1 MAXWIDTH 45.0")

er1904_1 = ml2 - sidemetal
er1904_2 = er1904_1 - pro
er1904_3 = er1904_2.sized(-22.5.um)
er1904 = er1904_3.sized(22.5.um)
er1904.output("ER1904:M2 MAXWIDTH 45.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERMP08:CONT(MP) SP MUST 1.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ermp08_1 = (mp - pgate).drc(if_any(corners.count == 4))
ermp08_2 = (mp - pgate).drc(if_any(corners.count == 6))
ermp08_3 = cnt_mp.sized(0.5.um).sized(-0.5.um)
ermp08_4 = ermp08_1 - ermp08_3
ermp08_5 = ermp08_2 - ermp08_3
ermp08_6 = ermp08_4.drc(if_any(corners.count > 8))
ermp08_7 = ermp08_5.drc(if_any(corners.count > 10))
# ermp08_7 = ermp08_5.drc(if_any(corners.count > 12))
ermp08_8 = (mp -pgate).overlapping(ermp08_6) - ermp08_6
ermp08_9 = (mp -pgate).overlapping(ermp08_7) - ermp08_7
ermp08_10 = cnt_mp.space(1.0.um).polygons
ERMP08 = ermp08_8 + ermp08_9 + ermp08_10
ERMP08.output("ERMP08:CONT(MP) SP MUST 1.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERMP11:SG(MP)-CONT SP MUST 1.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ermp11_1 = cnt_mp.separation(gate_mp, 1.01.um, projection).polygons - cnt_mp.separation(gate_mp, 0.99.um, projection).polygons
ERMP11 = cnt_mp.not_interacting(ermp11_1)
ERMP11.output("ERMP11:SG(MP)-CONT SP MUST 1.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERMN09:CONT(MN) SP MUST 1.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ermn09_1 = (mn - ngate).drc(if_any(corners.count == 4))
ermn09_2 = (mn - ngate).drc(if_any(corners.count == 6))
ermn09_3 = cnt_mn.sized(0.5.um).sized(-0.5.um)
ermn09_4 = ermn09_1 - ermn09_3
ermn09_5 = ermn09_2 - ermn09_3
ermn09_6 = ermn09_4.drc(if_any(corners.count > 8))
ermn09_7 = ermn09_5.drc(if_any(corners.count > 10))
# ermn09_7 = ermn09_5.drc(if_any(corners.count > 12))
ermn09_8 = (mn - ngate).overlapping(ermn09_6) - ermn09_6
ermn09_9 = (mn - ngate).overlapping(ermn09_7) - ermn09_7
ermn09_10 = cnt_mn.space(1.0.um).polygons
ERMN09 = ermn09_8 + ermn09_9 + ermn09_10
ERMN09.output("ERMN09:CONT(MN) SP MUST 1.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERMN12:SG(MN)-CONT(MN) SP MUST 1.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ermn12_1 = cnt_mn.separation(gate_mn, 1.01.um, projection).polygons - cnt_mn.separation(gate_mn, 0.99.um, projection).polygons
ERMN12 = cnt_mn.not_interacting(ermn12_1)
ERMN12.output("ERMN12:SG(MN)-CONT SP MUST 1.0")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERCSIO06:M1(CSIO CL) SP MUST 10.0
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
l_csio_ring = diff.inside(dlcsio).not(diff & pol & dlcsio)
m1_csio_ring = ml1.and(dlcsio).not(ml1.and(dlcsio).overlapping(pol.and(dlcsio))).and(l_csio_ring)
diff_csio = diff.interacting(dlcsio)
diff_csio_ring = diff_csio.interacting(m1_csio_ring)
ercsio06_0 = diff_csio_ring - m1_csio_ring

ercsio06_1 = ercsio06_0.select do |polygon|
  polygon_height(polygon) < 10.um - 1.dbu
end
ercsio06_1.output("ERCSIO06:M1(CSIO CL) SP MUST 10.0 (less)")

ercsio06_1 = ercsio06_0.select do |polygon|
  polygon_height(polygon) > 10.um + 1.dbu
end
ercsio06_1.output("ERCSIO06:M1(CSIO CL) SP MUST 10.0 (more)")

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERCSIO13:SG-L(CSIO) ENC MUST 1.4
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ercsio13_0 = (pol & dlcsio).enclosed(diff, 1.4.um).polygons
ercsio13_1 = (pol & dlcsio) - (diff & pol & dlcsio)
ercsio13_2 = ercsio13_1.sized(-0.7.um).sized(0.7.um)
ERCSIO13 = ercsio13_0 + ercsio13_2
ERCSIO13.output('ERCSIO13:SG-L(CSIO) ENC MUST 1.4')

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# ERCSIO16:CSIO SG-NSD-CL UNMATCH ER
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ercsio16_0 = (pol & dlcsio) ^ (nsd & dlcsio)
ercsio16_1 = (pol & dlcsio) ^ (cl  & dlcsio)
ercsio16_2 = (nsd & dlcsio) ^ (cl  & dlcsio)
ERCSIO16 = (ercsio16_0 + ercsio16_1 + ercsio16_2).merged
ERCSIO16.output('ERCSIO16:CSIO SG-NSD-CL UNMATCH ER')



