#  Check NO support Layers
#
(RHP ).output( "ERR01: CANNOT EXIST RHP " )
(HPBE).output( "ERR01: CANNOT EXIST HPBE" )
(HNBE).output( "ERR01: CANNOT EXIST HNBE" )
#(HPM ).output( "ERR01: CANNOT EXIST HPM " )
# --------- --------- --------- --------- --------- --------- ---------
#  Check off Grid
#
(PSUB).ongrid( 0.050 ).output( "ERR01: PSUB OFFGRID 0.050" )
(NW  ).ongrid( 0.050 ).output( "ERR01: NW OFFGRID 0.050" )
(HVNW).ongrid( 0.050 ).output( "ERR01: HVNW OFFGRID 0.050" )
(L   ).ongrid( 0.050 ).output( "ERR01: L OFFGRID 0.050" )
(NF  ).ongrid( 0.050 ).output( "ERR01: NF OFFGRID 0.050" )
(PF  ).ongrid( 0.050 ).output( "ERR01: PF OFFGRID 0.050" )
(CL  ).ongrid( 0.050 ).output( "ERR01: CL OFFGRID 0.050" )
(PBE ).ongrid( 0.050 ).output( "ERR01: PBE OFFGRID 0.050" )
(NBE ).ongrid( 0.050 ).output( "ERR01: NBE OFFGRID 0.050" )
(SG  ).ongrid( 0.050 ).output( "ERR01: SG OFFGRID 0.050" )
(PM  ).ongrid( 0.050 ).output( "ERR01: PM OFFGRID 0.050" )
(NM  ).ongrid( 0.050 ).output( "ERR01: NM OFFGRID 0.050" )
(R   ).ongrid( 0.050 ).output( "ERR01: R OFFGRID 0.050" )
(PSD ).ongrid( 0.050 ).output( "ERR01: PSD OFFGRID 0.050" )
(NSD ).ongrid( 0.050 ).output( "ERR01: NSD OFFGRID 0.050" )
(CONT).ongrid( 0.050 ).output( "ERR01: CONT OFFGRID 0.050" )
(M1  ).ongrid( 0.050 ).output( "ERR01: M1 OFFGRID 0.050" )
(TC  ).ongrid( 0.050 ).output( "ERR01: TC OFFGRID 0.050" )
(M2  ).ongrid( 0.050 ).output( "ERR01: M2 OFFGRID 0.050" )
(PRO ).ongrid( 0.050 ).output( "ERR01: PRO OFFGRID 0.050" )
# --------- --------- --------- --------- --------- --------- ---------
#  Twisted Polygon
#
(PSUB).odd_polygons.output("ERR01: PSUB twisted polygon")
(NW  ).odd_polygons.output("ERR01: NW twisted polygon")
(HVNW).odd_polygons.output("ERR01: HVNW twisted polygon")
(L   ).odd_polygons.output("ERR01: L twisted polygon")
(NF  ).odd_polygons.output("ERR01: NF twisted polygon")
(PF  ).odd_polygons.output("ERR01: PF twisted polygon")
(CL  ).odd_polygons.output("ERR01: CL twisted polygon")
(PBE ).odd_polygons.output("ERR01: PBE twisted polygon")
(NBE ).odd_polygons.output("ERR01: NBE twisted polygon")
(SG  ).odd_polygons.output("ERR01: SG twisted polygon")
(PM  ).odd_polygons.output("ERR01: PM twisted polygon")
(NM  ).odd_polygons.output("ERR01: NM twisted polygon")
(R   ).odd_polygons.output("ERR01: R twisted polygon")
(PSD ).odd_polygons.output("ERR01: PSD twisted polygon")
(NSD ).odd_polygons.output("ERR01: NSD twisted polygon")
(CONT).odd_polygons.output("ERR01: CONT twisted polygon")
(M1  ).odd_polygons.output("ERR01: M1 twisted polygon")
(TC  ).odd_polygons.output("ERR01: TC twisted polygon")
(M2  ).odd_polygons.output("ERR01: M2 twisted polygon")
(PRO ).odd_polygons.output("ERR01: PRO twisted polygon")
# --------- --------- --------- --------- --------- --------- ---------
#  Check Non-diagonal shape
#
(PSUB.edges).without_angle(diagonal).output( "ERR01: PSUB edge not 90 or 45 degrees" )
(NW.edges  ).without_angle(diagonal).output( "ERR01: NW edge not 90 or 45 degrees" )
(HVNW.edges).without_angle(diagonal).output( "ERR01: HVNW edge not 90 or 45 degrees" )
(L.edges   ).without_angle(diagonal).output( "ERR01: L edge not 90 or 45 degrees" )
(NF.edges  ).without_angle(diagonal).output( "ERR01: NF edge not 90 or 45 degrees" )
(PF.edges  ).without_angle(diagonal).output( "ERR01: PF edge not 90 or 45 degrees" )
(CL.edges  ).without_angle(diagonal).output( "ERR01: CL edge not 90 or 45 degrees" )
(PBE.edges ).without_angle(diagonal).output( "ERR01: PBE edge not 90 or 45 degrees" )
(NBE.edges ).without_angle(diagonal).output( "ERR01: NBE edge not 90 or 45 degrees" )
(SG.edges  ).without_angle(diagonal).output( "ERR01: SG edge not 90 or 45 degrees" )
(PM.edges  ).without_angle(diagonal).output( "ERR01: PM edge not 90 or 45 degrees" )
(NM.edges  ).without_angle(diagonal).output( "ERR01: NM edge not 90 or 45 degrees" )
(R.edges   ).without_angle(diagonal).output( "ERR01: R edge not 90 or 45 degrees" )
(PSD.edges ).without_angle(diagonal).output( "ERR01: PSD edge not 90 or 45 degrees" )
(NSD.edges ).without_angle(diagonal).output( "ERR01: NSD edge not 90 or 45 degrees" )
(CONT.edges).without_angle(diagonal).output( "ERR01: CONT edge not 90 or 45 degrees" )
(M1.edges  ).without_angle(diagonal).output( "ERR01: M1 edge not 90 or 45 degrees" )
(TC.edges  ).without_angle(diagonal).output( "ERR01: TC edge not 90 or 45 degrees" )
(M2.edges  ).without_angle(diagonal).output( "ERR01: M2 edge not 90 or 45 degrees" )
(PRO.edges ).without_angle(diagonal).output( "ERR01: PRO edge not 90 or 45 degrees" )
# --------- --------- --------- --------- --------- --------- ---------
#  Line 
#
(PSUB).drc( width <  8.0 ).output( "ERR01: Width for PSUB <  8.0" )
(NW  ).drc( width <  8.0 ).output( "ERR01: Width for NW   <  8.0" )
(HVNW).drc( width <  8.0 ).output( "ERR01: Width for HVNW <  8.0" )
(L   ).drc( width <  1.4 ).output( "ERR01: Width for L    <  1.4" )
(NF  ).drc( width <  8.0 ).output( "ERR01: Width for NF   <  8.0" )
(PF  ).drc( width <  3.0 ).output( "ERR01: Width for PF   <  3.0" )
(CL  ).drc( width <  3.0 ).output( "ERR01: Width for CL   <  3.0" )
(PBE ).drc( width <  4.2 ).output( "ERR01: Width for PBE  <  4.2" )
(NBE ).drc( width <  4.2 ).output( "ERR01: Width for NBE  <  4.2" )
(SG  ).drc( width <  1.0 ).output( "ERR01: Width for SG   <  1.0" )
(PM  ).drc( width <  4.2 ).output( "ERR01: Width for PM   <  4.2" )
(NM  ).drc( width <  4.2 ).output( "ERR01: Width for NM   <  4.2" )
(R   ).drc( width <  4.0 ).output( "ERR01: Width for R    <  4.0" )
(PSD ).drc( width <  3.8 ).output( "ERR01: Width for PSD  <  3.8" )
(NSD ).drc( width <  2.6 ).output( "ERR01: Width for NSD  <  2.6" )
(CONT).drc( width <  1.0 ).output( "ERR01: Width for CONT <  1.0" )
(M1  ).drc( width <  1.8 ).output( "ERR01: Width for M1   <  1.8" )
(TC  ).drc( width <  1.4 ).output( "ERR01: Width for TC   <  1.4" )
(M2  ).drc( width <  3.0 ).output( "ERR01: Width for M2   <  3.0" )
(PRO ).drc( width < 10.0 ).output( "ERR01: Width for PRO  < 10.0" )
# --------- --------- --------- --------- --------- --------- ---------
#  Space
#
(PSUB).drc( space <  4.0 ).output( "ERR01: Space for PSUB <  4.0" )
(NW  ).drc( space <  4.0 ).output( "ERR01: Space for NW   <  4.0" )
(HVNW).drc( space <  4.0 ).output( "ERR01: Space for HVNW <  4.0" )
(L   ).drc( space <  1.4 ).output( "ERR01: Space for L    <  1.4" )
(NF  ).drc( space <  2.0 ).output( "ERR01: Space for NF   <  2.0" )
(PF  ).drc( space <  2.0 ).output( "ERR01: Space for PF   <  2.0" )
(CL  ).drc( space <  3.0 ).output( "ERR01: Space for CL   <  3.0" )
(PBE ).drc( space <  2.6 ).output( "ERR01: Space for PBE  <  2.6" )
(NBE ).drc( space <  2.6 ).output( "ERR01: Space for NBE  <  2.6" )
(SG  ).drc( space <  1.2 ).output( "ERR01: Space for SG   <  1.2" )
(PM  ).drc( space <  2.6 ).output( "ERR01: Space for PM   <  2.6" )
(NM  ).drc( space <  2.6 ).output( "ERR01: Space for NM   <  2.6" )
(R   ).drc( space <  2.6 ).output( "ERR01: Space for R    <  2.6" )
(PSD ).drc( space <  2.2 ).output( "ERR01: Space for PSD  <  2.2" )
(NSD ).drc( space <  2.6 ).output( "ERR01: Space for NSD  <  2.6" )
(CONT).drc( space <  1.0 ).output( "ERR01: Space for CONT <  1.0" )
(M1  ).drc( space <  1.4 ).output( "ERR01: Space for M1   <  1.4" )
(TC  ).drc( space <  1.5 ).output( "ERR01: Space for TC   <  1.5" )
(M2  ).drc( space <  2.0 ).output( "ERR01: Space for M2   <  2.0" )
(PRO ).drc( space < 20.0 ).output( "ERR01: Space for PRO  < 20.0" )
