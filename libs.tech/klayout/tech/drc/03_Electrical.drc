# Basic check for layer polygons
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Original version was made by jun1okamura from TokaiRika's document 
# LICENSE: Apache License Version 2.0, January 2004,
#          http://www.apache.org/licenses/
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Drain connected to Backgate
#
COSP = (SDPE & antenna_check(GP, CO, 0.0))
COSN = (SDNE & antenna_check(GN, CO, 0.0))
COS  = (COSP + COSN)
CODP = (SDPE & CO - COS)
CODN = (SDNE & CO - COS)
COD  = (CODP + CODN)
COD_s = COD.drc((space(projection) <= 1.6).polygons) # Requires width and space from DRM
COS_s = COS.drc((space(projection) <= 1.6).polygons) # Requires width and space from DRM
# end of row diffusion contacts. enclosure is half max enclosure allowed without adding another CO
# DRM calculates to 4.8um, but actual layout is 5.1um, so add 0.3um fudge factor
COD_e = COD.edges.enclosed(AME_h, 2.5+(1.6+3.0)/2+0.3+1.dbu, projection).polygons
COS_e = COS.edges.enclosed(AME_h, 2.5+(1.6+3.0)/2+0.3+1.dbu, projection).polygons

SE = (SDPE + SDNE).select_covering(COS)
DE = (SDPE + SDNE).select_covering(COD)

GC_ext3 = GA.edges.inside_part(AME).extended_out(3.0).edges.inside_part(SE)
GC_ext7 = GA.edges.inside_part(AME).extended_out(7.0).edges.inside_part(DE)
# COS.output("SOURCE")      # DEBUG
# COD.output("DRAIN")       # DEBUG
# ----- ------ ----- ----- ------ ----- ----- ------ ----- 
# Gate electrically connected to Substrate
#
GC_MP = antenna_check(SDP,  GC, 0.0)
GC_MN = antenna_check(SDN,  GC, 0.0)
GC_PE = antenna_check(SDPE, GC, 0.0)
GC_NE = antenna_check(SDNE, GC, 0.0)
GC_DP = antenna_check(DP,   GC, 0.0)
GC_DN = antenna_check(DN,   GC, 0.0)
GC_GP = antenna_check(GP,   GC, 0.0)
GC_GN = antenna_check(GN,   GC, 0.0)
#
GC_FL = (GC - (GC_MP + GC_MN + GC_PE + GC_NE + GC_DP + GC_DN + GC_GP + GC_GN))  # Floating Gate
#
# Select Top
#
TOPCELL = layout.cell_name
if SCRB.is_empty?
    source_topcell  = source.select("-*", "+#{TOPCELL}")
else
    source_topcell = source.select("-*")
end
#
# Select Top Metal Labels
#
M1LBL_TOP = source_topcell.labels(48, 0).texts(as_boxes)  # Top M1 Label
M2LBL_TOP = source_topcell.labels(49, 0).texts(as_boxes)  # Top M2 Label
#
# Top Pins and labels connection
#
connect(M1,   M1LBL_TOP)  # Attaches M1 top labels
connect(M2,   M2LBL_TOP)  # Attaches M2 top labels
#
# Gate electrically connected to Substrate
#
GC_M1LBL_TOP = antenna_check(M1LBL_TOP, GC, 0.0)
GC_M2LBL_TOP = antenna_check(M2LBL_TOP, GC, 0.0)
#
GC_FL_LBL_TOP = (GC - (GC_MP + GC_MN + GC_PE + GC_NE + GC_DP + GC_DN + GC_GP + GC_GN + GC_M1LBL_TOP + GC_M2LBL_TOP))  # Floating Gate
