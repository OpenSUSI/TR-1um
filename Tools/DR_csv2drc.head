if $input 
    if $top_cell
        source($input, $top_cell)
    else
        source($input)
    end
end
#
if $report
    report("TR-1um DRC(Drawing)", $report)
else
    report("TR-1um DRC(Drawing)")
end

skip_warnings = defined?($skip_warnings) &&
                $skip_warnings.to_s.downcase == "true"
puts "WARNING rules disabled (skip_warnings=true)" if skip_warnings

